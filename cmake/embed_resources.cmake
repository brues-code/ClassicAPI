# embed_resources.cmake — embed the addon and the bindings XML as Win32
# RCDATA resources.
#
# Runs at configure time. It writes two files into OUT_DIR:
#
#   embedded.rc           one `<id> RCDATA "<path>"` line per file; rc.exe
#                         reads each file straight from disk.
#   embedded_resources.h  the IDs the DLL looks up at runtime through
#                         src/embed/Resource.h:
#
#     namespace Embed::Ids { constexpr int kBindingsXml = ...; }
#     namespace Addons::Embedded::ClassicAPIFiles {
#         struct File { const char *path; int resourceId; };
#         constexpr File kFiles[] = { ... };
#         constexpr size_t kFileCount = ...;
#     }
#
# Addon paths are relative to the addon folder, in backslash form
# (`Util\Print.lua`) — the suffix the engine builds after
# `Interface\AddOns\!!!ClassicAPI\`. The DLL compares them ignoring case.
#
# The `.toc` is the one file that is not embedded verbatim: its
# `## Version:` line is stamped with ADDON_VERSION into a copy under
# OUT_DIR, so a release build is a pure function of `-DCLASSICAPI_TAG` and
# the source toc stays `DEV`.
#
# Rebuild triggers: adding or removing a file reconfigures through the
# caller's CONFIGURE_DEPENDS glob; editing the toc reconfigures through
# CMAKE_CONFIGURE_DEPENDS; editing any other file recompiles the .rc
# through its OBJECT_DEPENDS.
#
# Usage:
#   embed_resources(TARGET <t> ADDON_DIR <dir> ADDON_FILES <rel paths...>
#                   ADDON_VERSION <v> BINDINGS_XML <file> OUT_DIR <dir>)

# Write `content` to `path` only when it differs, so an unchanged
# reconfigure does not touch the file and trigger a rebuild.
function(_embed_write_if_changed path content)
    set(tmp "${path}.tmp")
    file(WRITE "${tmp}" "${content}")
    configure_file("${tmp}" "${path}" COPYONLY)
    file(REMOVE "${tmp}")
endfunction()

function(embed_resources)
    cmake_parse_arguments(E "" "TARGET;ADDON_DIR;ADDON_VERSION;BINDINGS_XML;OUT_DIR"
                          "ADDON_FILES" ${ARGN})

    set(rc "// Generated by cmake/embed_resources.cmake - do not edit.\n\n")
    set(manifest "")
    set(inputs "")
    set(id 1)

    string(APPEND rc "${id} RCDATA \"${E_BINDINGS_XML}\"\n")
    list(APPEND inputs "${E_BINDINGS_XML}")
    set(bindings_id ${id})
    math(EXPR id "${id} + 1")

    set(files ${E_ADDON_FILES})
    list(SORT files) # deterministic IDs
    foreach(rel ${files})
        set(abs "${E_ADDON_DIR}/${rel}")
        if(rel MATCHES "\\.toc$")
            file(READ "${abs}" toc)
            string(REGEX REPLACE "## Version:[^\n\r]*"
                   "## Version: ${E_ADDON_VERSION}" toc "${toc}")
            set(stamped "${E_OUT_DIR}/embed/${rel}")
            _embed_write_if_changed("${stamped}" "${toc}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${abs}")
            set(abs "${stamped}")
        endif()
        string(APPEND rc "${id} RCDATA \"${abs}\"\n")
        list(APPEND inputs "${abs}")
        string(REPLACE "/" "\\\\" rel_bs "${rel}")
        string(APPEND manifest "    { \"${rel_bs}\", ${id} },\n")
        math(EXPR id "${id} + 1")
    endforeach()

    _embed_write_if_changed("${E_OUT_DIR}/embedded.rc" "${rc}")
    _embed_write_if_changed("${E_OUT_DIR}/embedded_resources.h"
"// Generated by cmake/embed_resources.cmake — do not edit.
// Resource IDs for the RCDATA entries in embedded.rc. Load them through
// src/embed/Resource.h.

#pragma once

#include <cstddef>

namespace Embed::Ids {
constexpr int kBindingsXml = ${bindings_id};
} // namespace Embed::Ids

namespace Addons::Embedded::ClassicAPIFiles {

struct File {
    const char *path;
    int resourceId;
};

constexpr File kFiles[] = {
${manifest}};

constexpr size_t kFileCount = sizeof(kFiles) / sizeof(kFiles[0]);

} // namespace Addons::Embedded::ClassicAPIFiles
")

    target_sources(${E_TARGET} PRIVATE "${E_OUT_DIR}/embedded.rc")
    set_source_files_properties("${E_OUT_DIR}/embedded.rc" PROPERTIES
        OBJECT_DEPENDS "${inputs}")
endfunction()
