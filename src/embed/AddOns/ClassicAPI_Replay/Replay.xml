<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- A unit in the unit list: its name, and a mark while the camera follows it. -->
	<Button name="ClassicAPIReplayUnitRowTemplate" virtual="true">
		<Size x="100" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Selected" setAllPoints="true" hidden="true">
					<Color r="1" g="0.82" b="0" a="0.25"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT">
					<Size y="16"/>
					<Anchors>
						<Anchor point="LEFT" x="4"/>
						<Anchor point="RIGHT" x="-18"/>
					</Anchors>
				</FontString>
				<Texture parentKey="Mark" file="Interface\TargetingFrame\UI-RaidTargetingIcons" hidden="true">
					<Size x="12" y="12"/>
					<Anchors>
						<Anchor point="RIGHT" x="-3"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD"/>
	</Button>
	<!-- An aura on the unit frame, as 1.12's TargetBuffButtonTemplate and
	     TargetDebuffButtonTemplate: the icon, and for a debuff its border in
	     its dispel color and its stacks. Over the icon, as retail's target
	     auras show it, a reversed cooldown sweep of its duration, and the
	     time it has left. -->
	<Button name="ClassicAPIReplayAuraTemplate" virtual="true">
		<Size x="21" y="21"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Border" file="Interface\Buttons\UI-Debuff-Overlays" hidden="true">
					<Size x="23" y="23"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<TexCoords left="0.296875" right="0.5703125" top="0" bottom="0.515625"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Cooldown parentKey="Cooldown" inherits="CooldownFrameTemplate" reverse="true" hideCountdownNumbers="true"/>
			<Frame parentKey="TextFrame" setAllPoints="true">
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Time" inherits="NumberFontNormalSmall">
							<Anchors>
								<Anchor point="CENTER" x="0" y="0"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Count" inherits="NumberFontNormalSmall">
							<Anchors>
								<Anchor point="BOTTOMRIGHT" x="-1" y="0"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Button>
	<!-- A bar of the unit frame, with its value as text. -->
	<StatusBar name="ClassicAPIReplayUnitBarTemplate" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="TextStatusBarText">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
	</StatusBar>
	<Frame name="ClassicAPIReplayFrame" parent="UIParent" toplevel="true" movable="true" enableMouse="true" hidden="true" frameStrata="DIALOG">
		<Size x="1000" y="640"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<EdgeSize>
				<AbsValue val="32"/>
			</EdgeSize>
			<TileSize>
				<AbsValue val="32"/>
			</TileSize>
			<BackgroundInsets>
				<AbsInset left="11" right="12" top="12" bottom="11"/>
			</BackgroundInsets>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Title" inherits="GameFontNormal">
					<Anchors>
						<Anchor point="TOP" x="0" y="-18"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Status" inherits="GameFontHighlightSmall" justifyH="RIGHT">
					<Size x="300" y="20"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="-40" y="-42"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Time" inherits="GameFontHighlightSmall" justifyH="RIGHT">
					<Size x="110" y="20"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="-22" y="19"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-6" y="-6"/>
				</Anchors>
			</Button>
			<DropdownButton parentKey="LogDropdown" inherits="WowStyle1DropdownTemplate">
				<Size x="260" y="26"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="22" y="-38"/>
				</Anchors>
			</DropdownButton>
			<DropdownButton parentKey="SegmentDropdown" inherits="WowStyle1DropdownTemplate">
				<Size x="320" y="26"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="292" y="-38"/>
				</Anchors>
			</DropdownButton>
			<Frame parentKey="UnitList">
				<Size x="180"/>
				<Anchors>
					<Anchor point="TOPRIGHT" x="-16" y="-72"/>
					<Anchor point="BOTTOMRIGHT" x="-16" y="50"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture setAllPoints="true">
							<Color r="0" g="0" b="0" a="0.85"/>
						</Texture>
					</Layer>
				</Layers>
				<Frames>
					<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
						<Anchors>
							<Anchor point="TOPRIGHT"/>
							<Anchor point="BOTTOMRIGHT"/>
						</Anchors>
					</EventFrame>
					<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
						<Anchors>
							<Anchor point="TOPLEFT" x="2" y="-2"/>
							<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBar" relativePoint="BOTTOMLEFT" x="-2" y="2"/>
						</Anchors>
					</Frame>
				</Frames>
			</Frame>
			<ModelScene parentKey="Scene" inherits="ModelSceneMixinTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="16" y="-72"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.UnitList" relativePoint="BOTTOMLEFT" x="-6" y="0"/>
				</Anchors>
				<Frames>
					<Frame parentKey="ControlFrame" inherits="ModelSceneControlFrameTemplate">
						<Anchors>
							<Anchor point="TOP" x="0" y="-10"/>
						</Anchors>
					</Frame>
					<!-- The followed unit, laid out as 1.12's TargetFrame
					     (TargetFrame.xml), with its target as TargetofTargetFrame. -->
					<Frame parentKey="UnitFrame" enableMouse="true" hidden="true">
						<Size x="232" y="100"/>
						<Anchors>
							<Anchor point="TOPLEFT" x="4" y="-4"/>
						</Anchors>
						<Layers>
							<Layer level="BACKGROUND">
								<Texture parentKey="Background">
									<Size x="119" y="41"/>
									<Anchors>
										<Anchor point="TOPRIGHT" x="-106" y="-22"/>
									</Anchors>
									<Color r="0" g="0" b="0" a="0.5"/>
								</Texture>
								<Texture parentKey="NameBackground" file="Interface\TargetingFrame\UI-TargetingFrame-LevelBackground">
									<Size x="119" y="19"/>
									<Anchors>
										<Anchor point="TOPRIGHT" x="-106" y="-22"/>
									</Anchors>
								</Texture>
							</Layer>
							<Layer level="BORDER">
								<Texture parentKey="Portrait">
									<Size x="64" y="64"/>
									<Anchors>
										<Anchor point="TOPRIGHT" x="-42" y="-12"/>
									</Anchors>
								</Texture>
							</Layer>
						</Layers>
						<Frames>
							<Frame parentKey="TextureFrame" setAllPoints="true">
								<Layers>
									<Layer level="BACKGROUND">
										<Texture file="Interface\TargetingFrame\UI-TargetingFrame">
											<TexCoords left="0.09375" right="1.0" top="0" bottom="0.78125"/>
										</Texture>
										<FontString parentKey="Name" inherits="GameFontNormalSmall">
											<Size x="100" y="10"/>
											<Anchors>
												<Anchor point="CENTER" x="-50" y="19"/>
											</Anchors>
										</FontString>
										<FontString parentKey="Level" inherits="GameFontNormalSmall">
											<Anchors>
												<Anchor point="CENTER" x="63" y="-16"/>
											</Anchors>
										</FontString>
										<FontString parentKey="Dead" inherits="GameFontNormalSmall" text="DEAD">
											<Anchors>
												<Anchor point="CENTER" x="-50" y="3"/>
											</Anchors>
										</FontString>
									</Layer>
									<Layer level="ARTWORK">
										<Texture parentKey="HighLevel" file="Interface\TargetingFrame\UI-TargetingFrame-Skull" hidden="true">
											<Size x="16" y="16"/>
											<Anchors>
												<Anchor point="CENTER" x="63" y="-16"/>
											</Anchors>
										</Texture>
										<Texture parentKey="RaidTargetIcon" file="Interface\TargetingFrame\UI-RaidTargetingIcons" hidden="true">
											<Size x="26" y="26"/>
											<Anchors>
												<Anchor point="CENTER" relativePoint="TOPRIGHT" x="-73" y="-14"/>
											</Anchors>
										</Texture>
									</Layer>
								</Layers>
							</Frame>
							<StatusBar parentKey="HealthBar" inherits="ClassicAPIReplayUnitBarTemplate">
								<Size x="119" y="12"/>
								<Anchors>
									<Anchor point="TOPRIGHT" x="-106" y="-41"/>
								</Anchors>
								<BarColor r="0" g="1" b="0"/>
							</StatusBar>
							<StatusBar parentKey="ManaBar" inherits="ClassicAPIReplayUnitBarTemplate">
								<Size x="119" y="12"/>
								<Anchors>
									<Anchor point="TOPRIGHT" x="-106" y="-52"/>
								</Anchors>
								<BarColor r="0" g="0" b="1"/>
							</StatusBar>
							<Button parentKey="TargetOfTarget" hidden="true">
								<Size x="93" y="45"/>
								<Anchors>
									<Anchor point="BOTTOMRIGHT" x="-35" y="-10"/>
								</Anchors>
								<Layers>
									<Layer level="BACKGROUND">
										<Texture>
											<Size x="46" y="15"/>
											<Anchors>
												<Anchor point="BOTTOMLEFT" x="42" y="13"/>
											</Anchors>
											<Color r="0" g="0" b="0" a="0.5"/>
										</Texture>
									</Layer>
									<Layer level="BORDER">
										<Texture parentKey="Portrait">
											<Size x="35" y="35"/>
											<Anchors>
												<Anchor point="TOPLEFT" x="6" y="-6"/>
											</Anchors>
										</Texture>
									</Layer>
								</Layers>
								<Frames>
									<Frame parentKey="TextureFrame" setAllPoints="true">
										<Layers>
											<Layer level="BORDER">
												<Texture file="Interface\TargetingFrame\UI-TargetofTargetFrame">
													<TexCoords left="0.015625" right="0.7265625" top="0" bottom="0.703125"/>
												</Texture>
												<FontString parentKey="Name" inherits="GameFontNormalSmall" justifyH="LEFT">
													<Size x="100" y="10"/>
													<Anchors>
														<Anchor point="BOTTOMLEFT" x="42" y="2"/>
													</Anchors>
												</FontString>
												<FontString parentKey="Dead" inherits="GameFontNormalSmall" text="DEAD">
													<Anchors>
														<Anchor point="CENTER" x="15" y="1"/>
													</Anchors>
												</FontString>
											</Layer>
										</Layers>
									</Frame>
									<StatusBar parentKey="HealthBar">
										<Size x="46" y="7"/>
										<Anchors>
											<Anchor point="TOPRIGHT" x="-2" y="-15"/>
										</Anchors>
										<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
										<BarColor r="0" g="1" b="0"/>
									</StatusBar>
									<StatusBar parentKey="ManaBar">
										<Size x="46" y="7"/>
										<Anchors>
											<Anchor point="TOPRIGHT" x="-2" y="-23"/>
										</Anchors>
										<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
										<BarColor r="0" g="0" b="1"/>
									</StatusBar>
								</Frames>
							</Button>
						</Frames>
					</Frame>
				</Frames>
			</ModelScene>
			<!-- A spell link's tooltip from the feed: 1.12's ItemRefTooltip
			     (ItemRef.xml), in the window, starting at the scene's bottom
			     right. -->
			<GameTooltip name="ClassicAPIReplaySpellTooltip" parentKey="SpellTooltip" inherits="GameTooltipTemplate" enableMouse="true" movable="true" hidden="true">
				<Size x="128" y="64"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Scene" relativePoint="BOTTOMRIGHT" x="-8" y="8"/>
				</Anchors>
				<Frames>
					<Button parentKey="CloseButton">
						<Size x="32" y="32"/>
						<Anchors>
							<Anchor point="TOPRIGHT" x="1" y="0"/>
						</Anchors>
						<Scripts>
							<OnClick>
								this:GetParent():Hide();
							</OnClick>
						</Scripts>
						<NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up"/>
						<PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down"/>
						<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
					</Button>
				</Frames>
				<Scripts>
					<OnLoad>
						GameTooltip_OnLoad();
						this:SetPadding(16);
						this:RegisterForDrag("LeftButton");
					</OnLoad>
					<OnDragStart>
						this:StartMoving();
					</OnDragStart>
					<OnDragStop>
						this:StopMovingOrSizing();
						ValidateFramePosition(this);
					</OnDragStop>
				</Scripts>
			</GameTooltip>
			<!-- A unit's tooltip, the window's own GameTooltip, at the scene's
			     bottom right as the world's mouseover tooltip sits at the
			     screen's (GameTooltip_SetDefaultAnchor). UnitTooltip.lua
			     places it. -->
			<GameTooltip name="ClassicAPIReplayUnitTooltip" parentKey="UnitTooltip" inherits="GameTooltipTemplate" hidden="true">
				<Scripts>
					<OnLoad>
						GameTooltip_OnLoad();
					</OnLoad>
				</Scripts>
			</GameTooltip>
			<Button parentKey="BackButton">
				<Size x="26" y="26"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="18" y="16"/>
				</Anchors>
				<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
				<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
			</Button>
			<Button parentKey="PlayButton" inherits="UIPanelButtonTemplate">
				<Size x="80" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.BackButton" relativePoint="RIGHT" x="2" y="0"/>
				</Anchors>
			</Button>
			<Button parentKey="ForwardButton">
				<Size x="26" y="26"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.PlayButton" relativePoint="RIGHT" x="2" y="0"/>
				</Anchors>
				<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
				<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
			</Button>
			<Button parentKey="SpeedButton" inherits="UIPanelButtonTemplate">
				<Size x="56" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.ForwardButton" relativePoint="RIGHT" x="4" y="0"/>
				</Anchors>
			</Button>
			<Slider parentKey="Timeline" inherits="MinimalSliderTemplate">
				<Size x="10" y="17"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.SpeedButton" relativePoint="RIGHT" x="8" y="0"/>
					<Anchor point="RIGHT" relativeKey="$parent.Time" relativePoint="LEFT" x="-8" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<!-- Where a hover over the timeline would go. -->
						<Texture parentKey="Ghost" hidden="true">
							<Size x="1" y="14"/>
							<Color r="1" g="1" b="1" a="0.7"/>
						</Texture>
					</Layer>
				</Layers>
			</Slider>
		</Frames>
		<Scripts>
			<OnLoad>
				ClassicAPIReplay_OnLoad(this);
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>
