<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- ================================================================ -->
    <!-- Frame highlight (retail Blizzard_DebugTools.xml)                 -->
    <!-- ================================================================ -->

    <Frame name="FrameHighlightTemplate" mixin="AnchorHighlightMixin" frameStrata="TOOLTIP" virtual="true">
        <Layers>
            <Layer level="ARTWORK">
                <Texture setAllPoints="true">
                    <Color r="0.0" g="0.8" b="0.0" a=".4"/>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="FrameStackAnchorHighlightTemplate" parentArray="AnchorHighlights" virtual="true" enableMouse="false" frameStrata="TOOLTIP">
        <Layers>
            <Layer level="ARTWORK">
                <Texture setAllPoints="true">
                    <Color r="0.6" g="0.6" b="0.2" a=".4"/>
                </Texture>
                <Texture parentKey="AnchorPoint">
                    <Size x="4" y="4"/>
                    <Color r="1.0" g="0.0" b="0.0" a=".4"/>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <!-- ================================================================ -->
    <!-- Tooltips                                                         -->
    <!-- ================================================================ -->

    <GameTooltip name="FrameStackTooltip" frameStrata="TOOLTIP" hidden="true" parent="UIParent" inherits="GameTooltipTemplate">
        <Scripts>
            <OnLoad>FrameStackTooltip_OnLoad(this);</OnLoad>
            <OnShow>FrameStackTooltip_OnShow(this);</OnShow>
            <OnEnter>FrameStackTooltip_OnEnter(this);</OnEnter>
            <OnUpdate>FrameStackTooltip_OnUpdate(this, arg1);</OnUpdate>
            <OnEvent>FrameStackTooltip_OnEvent(this, event, arg1, arg2);</OnEvent>
            <OnTooltipSetFrameStack>FrameStackTooltip_OnTooltipSetFrameStack(this, arg1);</OnTooltipSetFrameStack>
        </Scripts>
    </GameTooltip>

</Ui>
