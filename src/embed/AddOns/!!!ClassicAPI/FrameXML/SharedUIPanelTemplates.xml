<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
	Templates from retail's Blizzard_SharedXML/Mainline/SharedUIPanelTemplates.xml.
	Retail draws the close button, the resize grip and some controls with
	atlases this client does not have, so:
	- The close button is 1.12's own (UIPanelCloseButton's art).
	- The resize grip is the chat frame's expand arrow, turned to point at
	  the corner.
	- No FrameGlow, gamepad jump hints, TopTileStreaks or button bar, and
	  no FocusFramesInterfaceMixin.
	- DarkMenuElementTemplate's hover sets all points: retail leaves it
	  unanchored, which fills the row there; 1.12's loader gives an
	  unanchored region no points.
	- DropdownWithSteppersAndLabelTemplate's label is GameFontHighlightMedium:
	  this client has no GameFontHighlightMed2.
	-->
	<Script file="NineSlice.lua"/>
	<Script file="NineSliceLayouts.lua"/>
	<Script file="PortraitFrame.lua"/>
	<Script file="SharedUIPanelTemplates.lua"/>

	<Frame name="TruncatedTooltipScriptTemplate" virtual="true">
		<Scripts>
			<OnEnter function="TruncatedTooltipScript_OnEnter"/>
			<OnLeave function="TruncatedTooltipScript_OnLeave"/>
		</Scripts>
	</Frame>

	<Button name="PanelDragBarTemplate" mixin="PanelDragBarMixin" virtual="true">
		<KeyValues>
			<!-- If true, will show the move cursor when hovering the bar, rather than only when dragged -->
			<KeyValue key="showCursorOnHover" value="false" type="boolean"/>
		</KeyValues>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
		</Scripts>
	</Button>

	<!-- The red X is 1.12's group loot pass button, which has its own highlight. -->
	<Button name="UIResetButtonTemplate" hidden="true" virtual="true">
		<Size x="23" y="23"/>
		<NormalTexture file="Interface\Buttons\UI-GroupLoot-Pass-Up" setAllPoints="true"/>
		<HighlightTexture file="Interface\Buttons\UI-GroupLoot-Pass-Highlight" alphaMode="ADD" setAllPoints="true"/>
	</Button>

	<Button name="UIPanelCloseButtonNoScripts" frameLevel="510" virtual="true">
		<Size x="24" y="24"/>
		<DisabledTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Disabled"/>
		<NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up"/>
		<PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down"/>
		<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
	</Button>
	<Button name="UIPanelCloseButtonDefaultAnchors" mixin="UIPanelCloseButtonDefaultAnchorsMixin" inherits="UIPanelCloseButtonNoScripts" virtual="true">
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick function="UIPanelCloseButton_OnClick"/>
		</Scripts>
	</Button>

	<Frame name="NineSliceCodeTemplate" mixin="NineSlicePanelMixin" virtual="true">
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

<!--
*******************************************************************************
   Frame border element
	Can have any arbitrary NineSlice theme applied, appears over all frame
	content, but under any elements like tutorials, notifications, custom
	artwork, etc...
*******************************************************************************
-->
	<Frame name="NineSlicePanelTemplate" inherits="NineSliceCodeTemplate" frameLevel="500" setAllPoints="true" virtual="true"/>
<!--
*******************************************************************************
    InsetFrameTemplate

	This is the inner frame used for content by many panels.
*******************************************************************************
-->
	<Frame name="InsetFrameTemplate" useParentLevel="true" virtual="true">
		<KeyValues>
			<KeyValue key="layoutType" value="InsetFrameTemplate" type="string"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="-5">
				<!-- TODO: Convert this to atlas -->
				<Texture parentKey="Bg" file="Interface\FrameGeneral\UI-Background-Marble" horizTile="true" vertTile="true" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="NineSlice" useParentLevel="true" inherits="NineSlicePanelTemplate"/>
		</Frames>
	</Frame>

	<Frame name="FlatPanelBackgroundTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="BottomLeft" atlas="uiframebackground-nineslice-cornerbottomleft" useAtlasSize="true">
					<Anchors>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<Color color="PANEL_BACKGROUND_COLOR"/>
				</Texture>
				<Texture parentKey="BottomRight" atlas="uiframebackground-nineslice-cornerbottomright" useAtlasSize="true">
					<Anchors>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<Color color="PANEL_BACKGROUND_COLOR"/>
				</Texture>
				<Texture parentKey="BottomEdge">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.BottomLeft" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<Color color="PANEL_BACKGROUND_COLOR"/>
				</Texture>
				<Texture parentKey="TopSection">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRight" relativePoint="TOPRIGHT"/>
					</Anchors>
					<Color color="PANEL_BACKGROUND_COLOR"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

<!--
*******************************************************************************
   Simple Panel templates
	Barebones panel templates that can have space for a button bar at the bottom
	and an inset for content, the inset defaults to being vertically centered
	with sufficient padding for a bottom row of buttons
*******************************************************************************
-->
	<Frame name="SimplePanelTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="layoutType" value="SimplePanelTemplate" type="string"/>
		</KeyValues>
		<Size x="338" y="424"/>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="-6">
				<Texture name="$parentBg" file="Interface\FrameGeneral\UI-Background-Rock" horizTile="true" vertTile="true" parentKey="Bg">
					<Anchors>
						<Anchor point="TOPLEFT" x="0" y="-6"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="3"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="Inset" inherits="InsetFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-26"/>
					<Anchor point="BOTTOMRIGHT" x="-6" y="26"/>
				</Anchors>
			</Frame>
			<Frame parentKey="NineSlice" inherits="NineSlicePanelTemplate"/>
		</Frames>
	</Frame>

<!--
*******************************************************************************
    PortraitFrameTemplate
	This is an empty frame with space for a portrait/icon in the top left corner.
*******************************************************************************
-->
	<Frame name="PortraitFrameBaseTemplate" mixin="PortraitFrameMixin" virtual="true">
		<KeyValues>
			<KeyValue key="layoutType" value="PortraitFrameTemplate" type="string"/>
		</KeyValues>
		<Size x="338" y="424"/>
		<Frames>
			<Frame parentKey="NineSlice" inherits="NineSlicePanelTemplate"/>
			<Frame parentKey="PortraitContainer" frameLevel="400">
				<Size x="1" y="1"/>
				<Anchors>
					<Anchor point="TOPLEFT"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<Texture name="$parentPortrait" parentKey="portrait">
							<Size x="62" y="62"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="-5" y="7" />
							</Anchors>
						</Texture>
						<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
							<Anchors>
								<Anchor point="TOPLEFT" relativeKey="$parent.portrait" x="2" y="0"/>
								<Anchor point="BOTTOMRIGHT" relativeKey="$parent.portrait" x="-2" y="4"/>
							</Anchors>
							<MaskedTextures>
								<MaskedTexture childKey="portrait"/>
							</MaskedTextures>
						</MaskTexture>
					</Layer>
				</Layers>
			</Frame>
			<Frame parentKey="TitleContainer" frameLevel="510">
				<Size x="0" y="20"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="58" y="-1"/>
					<Anchor point="TOPRIGHT" x="-24" y="-1"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="$parentTitleText" inherits="GameFontNormal" text="" parentKey="TitleText" wordwrap="false">
							<Anchors>
								<Anchor point="TOP" x="0" y="-5"/>
								<Anchor point="LEFT"/>
								<Anchor point="RIGHT"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Frame>

	<Frame name="PortraitFrameTexturedBaseTemplate" inherits="PortraitFrameBaseTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="-6">
				<Texture name="$parentBg" file="Interface\FrameGeneral\UI-Background-Rock" horizTile="true" vertTile="true" parentKey="Bg">
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-21"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="PortraitFrameTemplateNoCloseButton" inherits="PortraitFrameTexturedBaseTemplate" virtual="true"/>

	<Frame name="PortraitFrameTemplate" inherits="PortraitFrameTemplateNoCloseButton" virtual="true">
		<Frames>
			<Button name="$parentCloseButton" parentKey="CloseButton" inherits="UIPanelCloseButtonDefaultAnchors"/>
		</Frames>
	</Frame>

	<Frame name="PortraitFrameTemplateMinimizable" inherits="PortraitFrameTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="layoutType" value="PortraitFrameTemplateMinimizable" type="string"/>
		</KeyValues>
	</Frame>

<!--
*******************************************************************************
    ButtonFrameTemplate
	This is a Portrait Frame that also has space for buttons along the bottom
	edge, and includes an inset content area.
*******************************************************************************
-->
	<Frame name="ButtonFrameBaseTemplate" inherits="PortraitFrameBaseTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="-6">
				<Texture name="$parentBg" file="Interface\FrameGeneral\UI-Background-Rock" horizTile="true" vertTile="true" parentKey="Bg">
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-21"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseButton" parentKey="CloseButton" inherits="UIPanelCloseButtonDefaultAnchors"/>
		</Frames>
	</Frame>

	<Frame name="ButtonFrameTemplate" inherits="ButtonFrameBaseTemplate" virtual="true">
		<Frames>
			<Frame name="$parentInset" parentKey="Inset" useParentLevel="true" inherits="InsetFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-60" />
					<Anchor point="BOTTOMRIGHT" x="-6" y="26" />
				</Anchors>
			</Frame>
		</Frames>
	</Frame>
<!--
*******************************************************************************
    ButtonFrameTemplateMinimizable
	This is a Button Frame that is minimizable
*******************************************************************************
-->
	<Frame name="ButtonFrameTemplateMinimizable" inherits="ButtonFrameTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="layoutType" value="PortraitFrameTemplateMinimizable" type="string"/>
		</KeyValues>
	</Frame>

	<Button name="PanelResizeButtonTemplate" mixin="PanelResizeButtonMixin" virtual="true">
		<Size x="16" y="16"/>
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
		<NormalTexture file="Interface\ChatFrame\ChatFrameExpandArrow" rotation="-45"/>
		<HighlightTexture file="Interface\ChatFrame\ChatFrameExpandArrow" rotation="-45" alphaMode="ADD"/>
	</Button>

	<Button name="DarkMenuElementTemplate" inherits="ResizeLayoutFrame" virtual="true">
		<Size x="1" y="20"/>
		<KeyValues>
			<KeyValue key="widthPadding" value="14" type="number"/>
		</KeyValues>
		<Frames>
			<Frame parentKey="HighlightBGTex" alpha="0" setAllPoints="true">
				<KeyValues>
					<KeyValue key="ignoreInLayout" value="true" type="boolean"/>
				</KeyValues>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture atlas="common-dropdown-customize-mouseover" useAtlasSize="true" setAllPoints="true"/>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Button>

	<Button name="SteppersIncrementButtonTemplate" inherits="WowStyle2IconButtonTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="normalAtlas" type="string" value="common-dropdown-icon-next"/>
			<KeyValue key="disabledAtlas" type="string" value="common-dropdown-icon-next-disabled"/>
		</KeyValues>
	</Button>

	<Button name="SteppersDecrementButtonTemplate" inherits="WowStyle2IconButtonTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="normalAtlas" type="string" value="common-dropdown-icon-back"/>
			<KeyValue key="disabledAtlas" type="string" value="common-dropdown-icon-back-disabled"/>
		</KeyValues>
	</Button>

	<Frame name="DropdownWithSteppersTemplate" mixin="DropdownWithSteppersMixin" virtual="true">
		<Size x="223" y="38"/>
		<Frames>
			<Button parentKey="IncrementButton" inherits="SteppersIncrementButtonTemplate"/>
			<Button parentKey="DecrementButton" inherits="SteppersDecrementButtonTemplate"/>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<!-- See DropdownWithSteppersTemplate for dropdown requirements. -->
	<Frame name="DropdownWithSteppersAndLabelTemplate" inherits="DropdownWithSteppersTemplate" mixin="DropdownWithSteppersAndLabelMixin" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontHighlightMedium">
					<Anchors>
						<Anchor point="RIGHT" relativeKey="$parent.DecrementButton" relativePoint="LEFT" x="-34"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
