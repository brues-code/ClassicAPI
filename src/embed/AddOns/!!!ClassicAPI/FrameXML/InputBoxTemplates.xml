<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
	Two templates from retail's Blizzard_SharedXML/Shared/InputBox/InputBoxTemplates.xml.
	- InputBoxTemplate is this client's own (1.12 FrameXML, same border art and
	  geometry), so it is not redefined.
	- The search and clear icons are atlases this client does not have. The
	  search icon is the world map's magnifying glass, cropped square. The
	  clear icon is the cancel button art, cropped to the button.
	- SearchBoxTemplate has no narration mixin.
	- Turtle's FrameXML has its own SearchBoxTemplate (a different box, which
	  its UI uses), and the client keeps the first template registered under a
	  name. So the retail box is ClassicAPISearchBoxTemplate, which ClassicAPI's
	  own UI inherits, and SearchBoxTemplate.xml names it SearchBoxTemplate on
	  every client but Turtle.
	-->
	<Script file="InputBoxTemplates.lua"/>

	<EditBox name="InputBoxInstructionsTemplate" inherits="InputBoxTemplate" virtual="true">
		<!--KeyValues>
			Optional
			<KeyValue key="disabledColor" value="GRAY_FONT_COLOR" type="global"/>
			<KeyValue key="enabledColor" value="HIGHLIGHT_FONT_COLOR" type="global"/>
			<KeyValue key="showTooltipForTruncatedInstructions" value="false" type="boolean"/>
		</KeyValues-->
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Instructions" justifyH="LEFT" justifyV="MIDDLE" inherits="GameFontDisableSmall">
					<Anchors>
						<Anchor point="TOPLEFT" x="16" y="0"/>
						<Anchor point="BOTTOMRIGHT" x="-20" y="0"/>
					</Anchors>
					<Color r="0.35" g="0.35" b="0.35"/>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnTextChanged function="InputBoxInstructions_OnTextChanged"/>
			<OnDisable function="InputBoxInstructions_OnDisable"/>
			<OnEnable function="InputBoxInstructions_OnEnable"/>
			<OnEnter function="InputBoxInstructions_OnEnter"/>
			<OnLeave function="InputBoxInstructions_OnLeave"/>
		</Scripts>
		<FontString inherits="GameFontHighlightSmall"/>
	</EditBox>

	<EditBox name="ClassicAPISearchBoxTemplate" inherits="InputBoxInstructionsTemplate" autoFocus="false" virtual="true">
		<KeyValues>
			<KeyValue key="instructionText" value="SEARCH" type="global"/>
		</KeyValues>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentSearchIcon" file="Interface\WorldMap\WorldMap-MagnifyingGlass" parentKey="searchIcon">
					<Size x="10" y="10"/>
					<Anchors>
						<Anchor point="LEFT" x="1" y="-1"/>
					</Anchors>
					<TexCoords left="0.09375" right="0.90625" top="0.03125" bottom="0.84375"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentClearButton" parentKey="clearButton" mixin="ClearButtonMixin" hidden="true">
				<Size x="17" y="17"/>
				<Anchors>
					<Anchor point="RIGHT" x="-3" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="Icon" file="Interface\Buttons\CancelButton-Up" alpha="0.5">
							<Size x="10" y="10"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="3" y="-3"/>
							</Anchors>
							<TexCoords left="0.21875" right="0.78125" top="0.21875" bottom="0.78125"/>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter method="OnEnter" />
					<OnLeave method="OnLeave" />
					<OnMouseDown method="OnMouseDown" />
					<OnMouseUp method="OnMouseUp" />
					<OnClick method="OnClick"/>
				</Scripts>
			</Button>
		</Frames>
		<TextInsets left="16" right="20" bottom="0" top="0"/>
		<Scripts>
			<OnLoad function="SearchBoxTemplate_OnLoad"/>
			<OnEscapePressed function="EditBox_ClearFocus"/>
			<OnEnterPressed function="EditBox_ClearFocus"/>
			<OnEditFocusLost function="SearchBoxTemplate_OnEditFocusLost"/>
			<OnEditFocusGained function="SearchBoxTemplate_OnEditFocusGained"/>
			<OnTextChanged function="SearchBoxTemplate_OnTextChanged"/>
		</Scripts>
	</EditBox>
</Ui>
