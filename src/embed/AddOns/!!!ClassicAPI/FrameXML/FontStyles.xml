<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
	Font objects from retail's Blizzard_Fonts_Shared/Shared/FontStyles.xml that
	1.12's Fonts.xml does not have. Retail builds them on its SystemFont
	families; here each one inherits the 1.12 font with the same face and
	size, so a localized client's own font files apply.
	- GameFontHighlightHuge: retail's GameFontNormalHuge in white. 1.12's
	  GameFontNormalHuge is the same 20 px face.
	- GameFontHighlightMedium: retail's SystemFont_Shadow_Med3 (14 px, with a
	  shadow) in white, so 1.12's GameFontNormal (which has the shadow) at
	  14 px.
	-->
	<Font name="GameFontHighlightHuge" inherits="GameFontNormalHuge" virtual="true">
		<Color r="1.0" g="1.0" b="1.0"/>
	</Font>
	<Font name="GameFontHighlightMedium" inherits="GameFontNormal" virtual="true">
		<FontHeight>
			<AbsValue val="14"/>
		</FontHeight>
		<Color r="1.0" g="1.0" b="1.0"/>
	</Font>
</Ui>
