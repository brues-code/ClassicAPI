<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- From retail's Blizzard_Menu/MenuTemplates.xml. WowStyle2DropdownTemplate,
	WowStyle2IconButtonTemplate and WowMenuDropdownHighlightRadioTemplate are not
	here yet: they draw Mainline atlases that need their own 1.12 art. -->
	<Button name="WowMenuAutoHideButtonTemplate" propagateMouseInput="Motion" virtual="true">
		<Layers>
			<Layer>
				<Texture parentKey="Texture"/>
			</Layer>
		</Layers>
	</Button>
</Ui>
