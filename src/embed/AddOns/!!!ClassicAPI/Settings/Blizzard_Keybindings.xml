<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
	Retail's Blizzard_Settings_Shared/Blizzard_Keybindings.xml.
	Differences:
	- The button text is one line by wordwrap="false": 1.12 font strings have
	  no maxLines. It has no name, as UIMenuButtonStretchTemplate's pieces
	  have none (see SharedUIPanelTemplates.xml). The fonts are 1.12's
	  inherits form of retail's style attribute.
	- The label takes no mouse: 1.12 font strings have no scripts, so a cut-off
	  binding name shows no tooltip.
	- The row sets enableMouse: retail's OnEnter script turns mouse input on,
	  and 1.12's does not.
	- No NewFeature label, because nothing in this client is new.
	-->
	<Button name="KeyBindingFrameBindingButtonTemplate" inherits="UIMenuButtonStretchTemplate" mixin="KeyBindingButtonMixin" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="SelectedHighlight" file="Interface\Buttons\UI-Silver-Button-Select" alphaMode="ADD" hidden="true">
					<Size x="160" y="20"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="-3"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<ButtonText parentKey="Text" wordwrap="false">
			<Size x="150" y="0"/>
			<Anchors>
				<Anchor point="CENTER" x="0" y="-1"/>
			</Anchors>
		</ButtonText>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
		<NormalFont inherits="GameFontHighlightSmall"/>
		<DisabledFont inherits="GameFontDisableSmall"/>
		<HighlightFont inherits="GameFontHighlightSmall"/>
	</Button>

	<Button name="KeyBindingFrameBindingButtonTemplateWithLabel" inherits="KeyBindingFrameBindingButtonTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<FontString parentKey="KeyLabel" inherits="GameFontNormalSmall">
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" x="4" y="5" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Button>

	<Frame name="KeyBindingFrameBindingTemplate" mixin="KeyBindingFrameBindingTemplateMixin" enableMouse="true" virtual="true">
		<Size x="560" y="25"/>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString parentKey="Label" inherits="GameFontNormal" wordwrap="false" justifyH="LEFT">
					<Size x="170" y="24"/>
				</FontString>
				<Texture parentKey="Highlight" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT" x="-5"/>
					</Anchors>
					<Color a="0.1" r="1" g="1" b="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="Button1" parentArray="Buttons" inherits="KeyBindingFrameBindingButtonTemplate">
				<KeyValues>
					<KeyValue key="SlotIndex" value="1" type="number"/>
				</KeyValues>
				<Size x="160" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativePoint="CENTER" x="-80"/>
				</Anchors>
			</Button>
			<Button parentKey="Button2" parentArray="Buttons" inherits="KeyBindingFrameBindingButtonTemplate">
				<KeyValues>
					<KeyValue key="SlotIndex" value="2" type="number"/>
				</KeyValues>
				<Size x="160" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Button1" relativePoint="RIGHT"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Frame>
</Ui>
