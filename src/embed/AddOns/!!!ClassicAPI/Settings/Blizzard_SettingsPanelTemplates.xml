<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
	Retail's Blizzard_Settings_Shared/Mainline/Blizzard_SettingsPanelTemplates.xml.
	Retail draws the window with a FlatPanelBackgroundTemplate and a
	NineSlice (layout ButtonFrameTemplateNoPortrait), which this client does
	not have. The window is drawn the way FrameXML\SharedUIPanelTemplates.xml
	draws ButtonFrameTemplate: the tooltip border as the frame's backdrop, a
	dark title bar under the title and a dark fill below it. The fill (Bg) is
	a texture of the window, under everything the window draws: as a child
	frame it drew over the window's own regions, its output line among them.
	The NineSlice frame stays, holding the title bar and the title, because
	the panel sets its title through NineSlice.Text.
	-->
	<Frame name="SettingsFrameTemplate" virtual="true">
		<Backdrop edgeFile="Interface\Tooltips\UI-Tooltip-Border">
			<EdgeSize val="16"/>
		</Backdrop>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Bg">
					<Anchors>
						<Anchor point="TOPLEFT" x="5" y="-24"/>
						<Anchor point="BOTTOMRIGHT" x="-5" y="5"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="0.75"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="NineSlice" useParentLevel="true" setAllPoints="true">
				<Layers>
					<Layer level="BACKGROUND">
						<Texture>
							<Anchors>
								<Anchor point="TOPLEFT" x="5" y="-5"/>
								<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" x="-5" y="-24"/>
							</Anchors>
							<Color r="0.1" g="0.1" b="0.1" a="0.95"/>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="Text" inherits="GameFontNormal" wordwrap="false">
							<Anchors>
								<Anchor point="TOP" x="0" y="-6"/>
								<Anchor point="LEFT" x="60"/>
								<Anchor point="RIGHT" x="-60"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			<Button parentKey="ClosePanelButton" inherits="UIPanelCloseButtonDefaultAnchors"/>
		</Frames>
	</Frame>
</Ui>
