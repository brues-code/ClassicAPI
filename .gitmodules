[submodule "external/minhook"]
	path = external/minhook
	url = https://github.com/TsudaKageyu/minhook.git
[submodule "external/unordered_dense"]
	path = external/unordered_dense
	url = https://github.com/martinus/unordered_dense.git
[submodule "external/rapidjson"]
	path = external/rapidjson
	url = https://github.com/Tencent/rapidjson.git
	shallow = true
[submodule "external/SDL"]
	path = external/SDL
	url = https://github.com/libsdl-org/SDL.git
	shallow = true
	ignore = dirty
[submodule "external/GamepadMotionHelpers"]
	path = external/GamepadMotionHelpers
	url = https://github.com/JibbSmart/GamepadMotionHelpers.git
